[Unit]
Description=Villa Agency OS — Internal Staff Dashboard (127.0.0.1:8085)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/anashadi/villa-agency-os
ExecStart=/usr/bin/python3 /home/anashadi/villa-agency-os/src/dashboard.py --db /home/anashadi/villa-agency-os/data/villa.db --port 8085
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
