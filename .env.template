# Villa Agency OS — environment template
# Copy to `.env` and fill values locally. NEVER commit `.env` and never paste
# real credentials into chat, tickets, documents, or the AI co-pilot.

# ---- Database -------------------------------------------------------------
# Production of record is PostgreSQL (see docs/DATA_MODEL.md, ADR-0001).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
VILLA_DATABASE_URL=

# Dev/test fallback: SQLite file path used when VILLA_DATABASE_URL is empty.
VILLA_SQLITE_PATH=runtime/villa_agency.db

# ---- Runtime --------------------------------------------------------------
VILLA_ENV=development
VILLA_DEFAULT_CURRENCY=IDR
VILLA_LOG_LEVEL=INFO

# ---- Payment service provider (hosted page only; no card data in our systems)
PSP_PROVIDER=
PSP_MERCHANT_ID=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
# Secret used to verify inbound webhook signatures.
WEBHOOK_SIGNING_SECRET=

# ---- Messaging / channels (official providers only) -----------------------
EMAIL_PROVIDER_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- AI co-pilot (no guest PII, no card data, no passport scans) ----------
AI_PROVIDER_API_KEY=
AI_MODEL=

# ---- Alerting -------------------------------------------------------------
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
